        <mxCell id="S0" value="&lt;b&gt;Step 0: One-Time Setup&lt;/b&gt;&lt;br&gt;Wire Claude ↔ Linear MCP&lt;br&gt;Path A web/Desktop · Path B Claude Code CLI&lt;br&gt;Smoke test + verify connector&lt;br&gt;👤 Admins · 🤖 Claude · 🔌 MCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5C2E8A;fontColor=#FFFFFF;strokeColor=#3A1C58;fontSize=11;" vertex="1" parent="1">
